# ==============================================================================
# Llama Workbench Runtime Environment Configuration
# ==============================================================================

# Bind locally. Use an authenticated HTTPS reverse proxy for remote access.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8080

# Restrict browser origins. Set an exact HTTPS origin for remote access.
WORKBENCH_CORS_ORIGINS=localhost

# Local Model Configuration (Optional: Leave blank if using cloud Gemini or remote APIs)
WORKBENCH_MODEL_PATH=

# Context & Hardware Allocation
WORKBENCH_CTX_SIZE=4096
WORKBENCH_N_THREADS=4
WORKBENCH_N_GPU_LAYERS=0

# Runtime Working Directory & Paths
# Static Web UI Assets Document Root
WORKBENCH_PUBLIC_DIR=./public
WORKBENCH_DATA_DIR=./data
# Existing deployment workspace. This is a working directory, not a sandbox.
WORKBENCH_WORKSPACE_DIR=/home/ubuntu
WORKBENCH_LOG_FILE=./data/logs/workbench.log
WORKBENCH_PID_FILE=./data/workbench.pid

# Server bearer authentication. Required for non-loopback binding.
# Leave blank for local-only use, or set a unique value in workbench.env.
WORKBENCH_API_KEY=

# Agent tool privileges (DEF-QA-001)
# Activates native tool handlers (file_glob_search, read_file, exec_shell_command)
WORKBENCH_ENABLE_TOOLS=all

# Optional operator credentials; never included in the public UI bundle.
# Gemini browser credentials are configured in Provider Settings per browser.
# These variables do not configure an authentication/password subsystem.
# GEMINI_API_KEY=your_key_here
# GITHUB_TOKEN=your_token_here
# WORKBENCH_PASSWORD=change_me
