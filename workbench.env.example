# ==============================================================================
# Llama Workbench Runtime Environment Configuration
# ==============================================================================

# Network binding (0.0.0.0 enables access from remote browsers via public IP)
WORKBENCH_HOST=0.0.0.0
WORKBENCH_PORT=8080

# CORS origins (* permits external browser access with tools enabled)
WORKBENCH_CORS_ORIGINS=*

# Local Model Configuration (Optional: Leave blank if using cloud Gemini or remote APIs)
WORKBENCH_MODEL_PATH=

# Context & Hardware Allocation
WORKBENCH_CTX_SIZE=4096
WORKBENCH_N_THREADS=4
WORKBENCH_N_GPU_LAYERS=0

# Runtime Working Directory & Paths
# Static Web UI Assets Document Root
WORKBENCH_PUBLIC_DIR=./public
WORKBENCH_DATA_DIR=./data
# Autonomous workspace path (defaults to current user home directory)
WORKBENCH_WORKSPACE_DIR=${HOME}
WORKBENCH_LOG_FILE=./data/logs/workbench.log
WORKBENCH_PID_FILE=./data/workbench.pid

# Server API Protection (Optional: sets Bearer token for incoming requests to llama-server)
WORKBENCH_API_KEY=

# Agent tool privileges (DEF-QA-001)
# Activates native tool handlers (file_glob_search, read_file, exec_shell_command)
WORKBENCH_ENABLE_TOOLS=all
